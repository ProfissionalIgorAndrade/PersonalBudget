' ============================================================
' LEVEL 4 — CODE: Domain Model (Aggregates & Relationships)
' ============================================================

@startuml C4_L4_DomainModel
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam linetype ortho

title PersonalBudget — Nivel 4: Modelo de Dominio

package "Aggregate: User" #LightBlue {
    class User {
        +Id: Guid
        +Name: string
        +Email: Email
        +PasswordHash: PasswordHash
        +IsActive: bool
        +CreatedAt: DateTime
        --
        +Deactivate()
        +ChangePassword(newHash)
        +CanAuthenticate(): bool
    }
    class Email <<ValueObject>> {
        +Value: string
        --
        Normaliza lowercase
        Valida formato @
    }
    class PasswordHash <<ValueObject>> {
        +Value: string
        --
        SHA-256 Base64
    }
    User *-- Email
    User *-- PasswordHash
}

package "Aggregate: Household" #LightGreen {
    class Household {
        +Id: Guid
        +Name: string
        +CreatedAt: DateTime
    }
    class HouseholdMembership {
        +Id: Guid
        +HouseholdId: Guid
        +UserId: Guid
        +Role: HouseholdRole
        +JoinedAt: DateTime
    }
    class HouseholdMemberProfile {
        +Id: Guid
        +HouseholdId: Guid
        +UserId: Guid?
        +DisplayName: string
        +Kind: HouseholdMemberProfileKind
        +SortOrder: int
        +IsActive: bool
    }
    class HouseholdInvite {
        +Id: Guid
        +HouseholdId: Guid
        +InvitedByUserId: Guid
        +Token: string
        +Status: HouseholdInviteStatus
        +ExpiresAt: DateTime
        --
        +Accept()
        +Revoke()
        +IsExpired(): bool
    }
    enum HouseholdRole {
        Owner
        Member
    }
    enum HouseholdInviteStatus {
        Pending
        Accepted
        Expired
        Revoked
    }
    enum HouseholdMemberProfileKind {
        LinkedUser
        Joint
    }
    Household "1" o-- "0..*" HouseholdMembership
    Household "1" o-- "0..*" HouseholdMemberProfile
    Household "1" o-- "0..*" HouseholdInvite
    HouseholdMembership --> HouseholdRole
    HouseholdMemberProfile --> HouseholdMemberProfileKind
    HouseholdInvite --> HouseholdInviteStatus
}

package "Aggregate: Account" #LightYellow {
    class Account {
        +Id: Guid
        +UserId: Guid
        +HouseholdId: Guid
        +Bank: Bank
        +Agency: BankAgency
        +Number: BankAccountNumber
        +Balance: Money
        +IsActive: bool
        +CreatedAt: DateTime
        --
        +UpdateBankInfo(...)
        +Deactivate()
        +Credit(amount)
        +Debit(amount)
    }
    class Money <<ValueObject>> {
        +Amount: decimal
        --
        Nao permite negativo
        +Add(other): Money
        +Subtract(other): Money
    }
    class BankAgency <<ValueObject>> {
        +Value: string
    }
    class BankAccountNumber <<ValueObject>> {
        +Value: string
    }
    enum Bank {
        Itau
        Nubank
        Inter
        Santander
        Bradesco
        Caixa
    }
    Account *-- Money
    Account *-- BankAgency
    Account *-- BankAccountNumber
    Account --> Bank
}

package "Aggregate: CreditCard" #LightCoral {
    class CreditCard {
        +Id: Guid
        +UserId: Guid
        +HouseholdId: Guid
        +AccountId: Guid?
        +Name: string
        +Limit: decimal
        +ClosingDay: int
        +DueDay: int
        +IsActive: bool
        --
        +GetOrCreateOpenStatement(date): Statement
        +AddExpense(transaction)
        +CloseStatement(statementId)
        +PayStatement(statementId)
    }
    class CreditCardStatement {
        +Id: Guid
        +CreditCardId: Guid
        +PeriodStart: DateTime
        +PeriodEnd: DateTime
        +ClosingDate: DateTime
        +DueDate: DateTime
        +ClosingMonth: int
        +ClosingYear: int
        +Status: BillStatus
        +TotalAmount: Money
        --
        +AddTransaction(amount, type)
        +Close()
        +MarkAsPaid()
    }
    enum BillStatus {
        Open
        Closed
        Paid
    }
    CreditCard "1" *-- "0..*" CreditCardStatement
    CreditCardStatement --> BillStatus
    CreditCardStatement *-- Money
}

package "Aggregate: Transaction" #Lavender {
    class Transaction {
        +Id: Guid
        +UserId: Guid
        +HouseholdId: Guid
        +AttributionProfileId: Guid
        +AccountId: Guid?
        +CategoryId: Guid
        +CreditCardId: Guid?
        +StatementId: Guid?
        +TransferId: Guid?
        +Type: TransactionType
        +PaymentMethod: PaymentMethod
        +Status: TransactionStatus
        +Frequency: TransactionFrequency
        +Amount: Money
        +Date: TransactionDate
        +Description: TransactionDescription
        +DueDate: DateTime?
        +ExpirationDate: DateTime?
        --
        +UpdateDetails(...)
        +Complete()
        +Cancel()
        +SetStatus(status)
    }
    class TransactionDate <<ValueObject>> {
        +Value: DateTime
    }
    class TransactionDescription <<ValueObject>> {
        +Value: string
        --
        Max 200 chars
        Required
    }
    enum TransactionType {
        Income
        Expense
    }
    enum PaymentMethod {
        Account
        CreditCard
        Cash
        Transfer
    }
    enum TransactionStatus {
        Pending
        Completed
        Simulated
        Cancelled
    }
    enum TransactionFrequency {
        Variable
        Fixed
        Installments
    }
    Transaction *-- Money
    Transaction *-- TransactionDate
    Transaction *-- TransactionDescription
    Transaction --> TransactionType
    Transaction --> PaymentMethod
    Transaction --> TransactionStatus
    Transaction --> TransactionFrequency
}

package "Aggregate: Category" #Wheat {
    class Category {
        +Id: Guid
        +HouseholdId: Guid
        +Name: string
        +Type: CategoryType
        +IsSystem: bool
        +IsActive: bool
        --
        +Rename(name)
        +Deactivate()
    }
    enum CategoryType {
        Income
        Expense
    }
    Category --> CategoryType
}

' Cross-aggregate relationships
User "1" -- "0..*" HouseholdMembership : participa
User "1" -- "0..*" HouseholdMemberProfile : vinculado
Household "1" -- "0..*" Account
Household "1" -- "0..*" Category
Household "1" -- "0..*" CreditCard
Household "1" -- "0..*" Transaction
CreditCard "1" -- "0..*" Transaction : referencia
CreditCardStatement "1" -- "0..*" Transaction : agrupa
Account "1" -- "0..*" Transaction : referencia
Category "1" -- "0..*" Transaction : classifica
HouseholdMemberProfile "1" -- "0..*" Transaction : atribui

@enduml

' ============================================================
' LEVEL 4 — CODE: Strategy Pattern (Transaction Creation)
' ============================================================

@startuml C4_L4_StrategyPattern
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontSize 12

title PersonalBudget — Nivel 4: Strategy Pattern — Criacao de Transacoes

interface ITransactionCreationStrategy {
    +CreateAsync(command: CreateTransactionCommand): Task<Transaction>
    +AppliesTo(paymentMethod: PaymentMethod): bool
}

abstract class TransactionCreationStrategyBase {
    #ValidateAccount(accountId, householdId)
    #ValidateCategory(categoryId, householdId)
    #ValidateCreditCard(cardId, householdId)
    --
    Validacoes comuns antes\nde delegar a subclasse
}

class AccountTransactionCreationStrategy {
    -_accountRepo: IAccountRepository
    -_transactionApplier: TransactionApplier
    --
    +AppliesTo(): Account, Cash
    Atualiza saldo da conta\nautomaticamente se\nstatus = Completed
}

class CreditCardTransactionCreationStrategy {
    -_creditCardRepo: ICreditCardRepository
    -_statementRepo: ICreditCardStatementRepository
    --
    +AppliesTo(): CreditCard
    Abre ou reutiliza fatura\ncom base em ClosingDay
}

class TransferTransactionCreationStrategy {
    -_accountRepo: IAccountRepository
    -_transactionApplier: TransactionApplier
    --
    +AppliesTo(): Transfer
    Cria 2 transacoes vinculadas.\nDebita origem, credita destino.
}

class TransactionService {
    -_strategies: IEnumerable<ITransactionCreationStrategy>
    --
    +CreateAsync(command)
    Seleciona strategy por\nPaymentMethod e delega
}

class TransactionApplier <<DomainService>> {
    +Apply(transaction, account)
    +Revert(transaction, account)
    --
    Aplica/reverte efeito\nde transacao no saldo\nda conta
}

ITransactionCreationStrategy <|.. TransactionCreationStrategyBase
TransactionCreationStrategyBase <|-- AccountTransactionCreationStrategy
TransactionCreationStrategyBase <|-- CreditCardTransactionCreationStrategy
TransactionCreationStrategyBase <|-- TransferTransactionCreationStrategy
TransactionService o-- ITransactionCreationStrategy
AccountTransactionCreationStrategy --> TransactionApplier
TransferTransactionCreationStrategy --> TransactionApplier

@enduml
