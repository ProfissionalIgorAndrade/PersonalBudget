Rel(authMiddleware, creditCardsCtrl, "Encaminha")
Rel(authMiddleware, categoriesCtrl, "Encaminha")

Rel(authController, jwtGenerator, "Usa para gerar token")
Rel(authController, appLayer, "Chama UserService")
Rel(householdsCtrl, userContext, "Le UserId do JWT")
Rel(householdsCtrl, appLayer, "Chama HouseholdService")
Rel(accountsCtrl, appLayer, "Chama AccountService\ne TransactionService")
Rel(transactionsCtrl, appLayer, "Chama TransactionService")
Rel(creditCardsCtrl, appLayer, "Chama CreditCardService\nCreditCardStatementService\nCreditCardImportService")
Rel(categoriesCtrl, appLayer, "Chama CategoryService")

