' ============================================================
' LEVEL 1 — SYSTEM CONTEXT
' ============================================================

@startuml C4_L1_SystemContext
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title PersonalBudget — Nivel 1: Contexto do Sistema

Person(user, "Usuario", "Pessoa fisica que controla\nsuas financas pessoais\nou compartilhadas com familia.")

System(personalBudget, "PersonalBudget", "Permite ao usuario registrar receitas,\ndespesas, faturas de cartao de credito\ne obter visao consolidada do orcamento\npor perfil de atribuicao.")

System_Ext(emailSystem, "Servico de E-mail", "Envio futuro de convites\nde household por e-mail.\n(nao implementado)")

System_Ext(bankOpenFinance, "Open Finance / Bancos", "Importacao futura de extratos\nbancarios via API.\n(nao implementado)")

Rel(user, personalBudget, "Gerencia financas via", "HTTPS / REST API + JWT")
Rel(personalBudget, emailSystem, "Envia convites de household", "SMTP (futuro)")
Rel(personalBudget, bankOpenFinance, "Importa extratos", "Open Finance API (futuro)")

@enduml

' ============================================================
' LEVEL 2 — CONTAINERS
' ============================================================

@startuml C4_L2_Containers
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title PersonalBudget — Nivel 2: Containers

Person(user, "Usuario", "Acessa o sistema via cliente HTTP\n(browser, app mobile, Postman)")

System_Boundary(personalBudget, "PersonalBudget") {

    Container(webApi, "PersonalBudget.Api", "ASP.NET Core 9\nWeb API", "Expoe endpoints REST.\nResponsavel por autenticacao JWT,\nroteamento, validacao de entrada\ne tratamento de erros.")

    Container(appLayer, "PersonalBudget.Application", "C# Class Library\n(.NET 9)", "Orquestra casos de uso.\nContem services, DTOs,\ninterfaces e estrategias\nde criacao de transacao.")

    Container(domainLayer, "PersonalBudget.Domain", "C# Class Library\n(.NET 9)", "Nucleo do negocio.\nEntidades, Value Objects,\nEnums, Domain Services\ne interfaces de repositorio.")

    Container(infraLayer, "PersonalBudget.Infrastructure", "C# Class Library\n(.NET 9) + EF Core 9", "Implementa acesso a dados.\nRepositorios, DbContext,\nconfiguracoes Fluent API,\nPasswordHasher e Seeds.")

    ContainerDb(database, "Banco de Dados", "EF Core InMemory\n(dev) / SQLite ou\nPostgreSQL (prod)", "Armazena usuarios, households,\ncontas, transacoes, cartoes,\nfaturas e categorias.")
}

Rel(user, webApi, "Faz requisicoes", "HTTPS / JSON")
Rel(webApi, appLayer, "Delega casos de uso", "Chamadas in-process")
Rel(appLayer, domainLayer, "Executa regras de negocio", "Chamadas in-process")
Rel(appLayer, infraLayer, "Persiste e consulta dados\n(via interfaces de repositorio)", "Chamadas in-process")
Rel(infraLayer, database, "Le e grava dados", "EF Core / SQL")

@enduml

