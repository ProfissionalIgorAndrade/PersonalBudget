@localhost = http://localhost:5047
@prod = https://personalbudget.fly.dev

# Select environment: localhost or prod
@HostAddress = {{localhost}}

###
### ============================================
### ACCOUNT ENDPOINTS
### ============================================

###
# Create Account
# Creates a new account with an initial balance
POST {{HostAddress}}/api/accounts
Content-Type: application/json

{
  "name": "Minha Conta Corrente",
  "initialBalance": 5000
}

###
# Get All Accounts
# Retrieves all existing accounts
GET {{HostAddress}}/api/accounts




