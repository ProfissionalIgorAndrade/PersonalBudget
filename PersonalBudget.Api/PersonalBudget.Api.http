@PersonalBudget.Api_HostAddress = http://localhost:5047

###
# Create Account
POST {{PersonalBudget.Api_HostAddress}}/api/accounts
Content-Type: application/json

{
  "name": "Minha Conta",
  "initialBalance": 5000
}


###
# Get All Accounts
GET {{PersonalBudget.Api_HostAddress}}/api/accounts


###
# Create Transactions with Income Type, Amount 2000, Status Completed
POST {{PersonalBudget.Api_HostAddress}}/api/transactions
Content-Type: application/json

{
  "accountId": "02262173-b3bc-4795-80fb-5015970520b5",
  "type": 1,
  "amount": 2000,
  "status": 2
}


