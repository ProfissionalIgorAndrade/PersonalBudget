###
### ============================================
### ACCOUNT ENDPOINTS
### ============================================

###
# Create new user in system
POST {{HostAddress}}/api/authentication/signin
Content-Type: application/json

{
  "Name": "User default",
  "Email": "email@email.com",
  "Password": "Password123@"
}


###
# Login with user in system
POST {{HostAddress}}/api/authentication/login
Content-Type: application/json

{
  "Email": "email@email.com",
  "Password": "Password123@"
}

###
# Create new account (requires auth)
POST {{HostAddress}}/api/accounts
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Family Account"
}

###
# Join existing account (requires auth)# JWT token (cole aqui o token retornado no login)
@accountId = "051b9eda-40fb-4047-93ab-c8237488282a"

POST {{HostAddress}}/api/accounts/join
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "AccountId": {{accountId}}
}