### USER ENDPOINTS


###
# Create new user in system
POST {{HostAddress}}/api/authentication/signin
Content-Type: application/json

{
  "Name": "User default",
  "Email": "email@email.com",
  "Password": "Password123@"
}


###
# Login with user in system
POST {{HostAddress}}/api/authentication/login
Content-Type: application/json

{
  "Email": "email@email.com",
  "Password": "Password123@"
}


### ACCOUNT ENDPOINTS


###
# Create new account (requires auth)
POST {{HostAddress}}/api/accounts
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "Bank": "Caixa",
  "Agency": "1301",
  "AccountNumber": "123456-7",
  "InitialBalance": 1005
}


###
# Get all accounts (requires auth)
GET {{HostAddress}}/api/accounts
Authorization: Bearer {{authToken}}
Content-Type: application/json

# ⚠️ Substitua pelo AccountId retornado no GET
@accountId = d178d6c0-7ef1-41e6-a235-12ae89ede066


### Update Account
PUT {{HostAddress}}/api/accounts/{{accountId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "bank": "Itau",
  "agency": "0002",
  "accountNumber": "654321"
}


### Delete Account
DELETE {{HostAddress}}/api/accounts/{{accountId}}
Authorization: Bearer {{authToken}}


### Category ENDPOINTS


### Create Category of Type Income
POST {{HostAddress}}/api/categories
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "Name": "Food",
  "Type": "Income"
}


### Create Category of Type Expense
POST {{HostAddress}}/api/categories
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "Name": "Food",
  "Type": "Expense"
}


### Get Categories
GET {{HostAddress}}/api/categories
Authorization: Bearer {{authToken}}

# ⚠️ Substitua pelo AccountId retornado no GET
@categoryId = cd9f99d8-4cac-469c-9ab0-c85580bb4dac


### Update Category
PUT {{HostAddress}}/api/categories/{{categoryId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "Name": "Food truck",
  "Type": "Income"
}


### Delete Category
DELETE {{HostAddress}}/api/categories/{{categoryId}}
Authorization: Bearer {{authToken}}

# ===============================
# CREDIT CARD
# ===============================


### Create Credit Card
POST {{HostAddress}}/api/credit-cards
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "accountId": "{{accountId}}",
  "name": "Visa Platinum",
  "limit": 12000,
  "closingDay": 10,
  "dueDay": 29
}


### Get All Credit Cards
GET {{HostAddress}}/api/credit-cards
Authorization: Bearer {{authToken}}


### Update Credit Card
@creditCardId = 8b6104d3-8e88-4844-91cd-8e6159cc989f

PUT {{HostAddress}}/api/credit-cards/{{creditCardId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Visa Platinum",
  "limit": 3500,
  "closingDay": 5,
  "dueDay": 31
}


### Delete Credit Card
DELETE {{HostAddress}}/api/credit-cards/{{creditCardId}}
Authorization: Bearer {{authToken}}